# Good Faith: every variable the app reads, with placeholders. Copy to .env.local for local dev (the scripts/setup-*.sh
# scripts write the real values there), or set them on the host. Never commit real values. README.md and
# docs/DEPLOY.md say what each one does.

# Supabase (server only; the secret key bypasses row level security)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me

# PayPal: SANDBOX only for the demo
PAYPAL_ENVIRONMENT=SANDBOX
PAYPAL_CLIENT_ID=replace_me
PAYPAL_CLIENT_SECRET=replace_me
# The sandbox webhook the app listens as (node scripts/paypal-webhook.mjs --register prints it). Every delivery's
# signature is checked with PayPal against it; unset, /api/paypal/webhook answers 503 and PayPal retries for 3 days.
# PAYPAL_WEBHOOK_ID=replace_me

# Anthropic
ANTHROPIC_API_KEY=sk-ant-replace_me
# ANTHROPIC_MODEL=claude-opus-5-5

# Optional: the owner workspace's account name in the sidebar (demo copies always show Harbor View Rentals)
# GOOD_FAITH_ACCOUNT=Harbor View Rentals

# Demo access gate (src/proxy.ts). Leave GOOD_FAITH_ACCESS_CODE unset for local dev: the gate is off and you are the
# owner. On a production host it must be set, or every page says the demo is not configured. Each browser that enters
# the judges' code gets its own private copy of the demo; the owner's code opens your own data. Use long random values,
# and a session secret of at least 32 characters (openssl rand -base64 48).
# GOOD_FAITH_ACCESS_CODE=judges-code-replace-me
# GOOD_FAITH_OWNER_CODE=owners-code-replace-me
# GOOD_FAITH_SESSION_SECRET=replace-with-at-least-32-random-characters
# Only on a host other than Render: the header that carries the caller's real address (Render's is found by itself).
# GOOD_FAITH_CLIENT_IP_HEADER=x-real-ip

# Daily limits per demo session (the owner has none), and the day's totals across every session (src/lib/limits.ts).
# GOOD_FAITH_DAILY_LEASE=5
# GOOD_FAITH_DAILY_INSPECT=3
# GOOD_FAITH_DAILY_CLOSE_OUT=4
# GOOD_FAITH_DAILY_INVOICE=5
# GOOD_FAITH_DAILY_TENANCY=10
# GOOD_FAITH_DAILY_UPLOAD_MB=100
# GOOD_FAITH_DAILY_AI_TOTAL=150
# GOOD_FAITH_DAILY_INVOICE_TOTAL=100
# GOOD_FAITH_DAILY_TENANCY_TOTAL=50
# GOOD_FAITH_DAILY_UPLOAD_MB_TOTAL=400
# New private demo copies a day: per caller address (entering the code, or Start over), and across every address.
# GOOD_FAITH_DAILY_COPIES=5
# GOOD_FAITH_DAILY_COPIES_TOTAL=60
# Rooms one inspection compares, and photos per room and phase it sends to Claude.
# GOOD_FAITH_INSPECT_ROOMS=6
# GOOD_FAITH_INSPECT_PHOTOS=6

# Laptop only (the demo seed and the deposit pool, npm run demo:pool): never on the host
# PAYPAL_SANDBOX_BUYER_EMAIL=sandbox-tenant@example.com
# PAYPAL_SANDBOX_BUYER_PASSWORD=replace_me
# PLAYWRIGHT_PYTHON=/path/to/python
# DEMO_BASE_URL=http://localhost:3210
# DEMO_ACCESS_CODE=owners-code-replace-me
